{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-before-commit.mjs\"",
            "timeout": 300,
            "statusMessage": "Typecheck and tests before commit/push…"
          }
        ]
      }
    ]
  }
}
